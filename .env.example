SITE_DOMAIN=nsantos.dev
NEXT_PUBLIC_SITE_URL=https://nsantos.dev

# Cloudflare Turnstile (site key é pública; secret só no servidor).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# Entrega do formulário (Resend)
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_FROM=Natã Santos <onboarding@resend.dev>
CONTACT_TO=

# Só ative se o HTTP passar pelo proxy da Cloudflare.
# TRUST_CF_CONNECTING_IP=true

# Porta no host (loopback). Produção na VPS: 3003 (nginx → 127.0.0.1:3003).
APP_PORT=3003

# Tag da imagem no GHCR (ex.: v0.2.0 ou latest).
IMAGE_TAG=latest
